; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Object Builder"
config/description="SDF engine test bed: carvable, joinable parts rendered from signed distance fields."
run/main_scene="res://workshop/workshop.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[physics]

; Tuned for millimetre-sized pieces (sawn offcuts): the engines' defaults allow a
; centimetre or two of overlap between colliding bodies.
jolt_physics_3d/simulation/penetration_slop=0.0002
jolt_physics_3d/simulation/speculative_contact_distance=0.002
3d/solver/contact_max_allowed_penetration=0.0002

[rendering]

renderer/rendering_method="forward_plus"
